# Copy to apps/server/.env for local dev.

NODE_ENV=development
# 4200 (renta/boarding-house uses 4000 — keep the two projects on separate ports).
PORT=4200
HOST=0.0.0.0

# Comma-separated allowed origins (admin dev server runs on 5273).
CORS_ORIGINS=http://localhost:5273

# Postgres (docker compose maps PostGIS to 55432). Empty => in-memory mock repos.
DATABASE_URL=postgres://firecare:firecare@localhost:55432/firecare

# Auth — REQUIRED. Generate a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Log level (pino): trace|debug|info|warn|error
LOG_LEVEL=info
